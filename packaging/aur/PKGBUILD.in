# Maintainer: NULLGRID <volosteele55 at proton dot me>
# Generated by packaging/aur/make-aur.sh from the release's tarballs.
pkgname=null-file-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Neon Lab file manager: tabs, command palette, undo and a graph view of your folders"
arch=('x86_64' 'aarch64')
url="https://nullgrid.dev"
license=('LicenseRef-NULLGRID')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'pango' 'gdk-pixbuf2'
         'hicolor-icon-theme' 'gcc-libs' 'glibc' 'xdg-utils')
optdepends=('wl-clipboard: copy paths on Wayland' 'xclip: copy paths on X11')
provides=('null-file')
conflicts=('null-file')
options=('!strip' '!debug')
source_x86_64=("https://github.com/Null0Grid/null-file/releases/download/${pkgver}/null-file-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/Null0Grid/null-file/releases/download/${pkgver}/null-file-${pkgver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  cd "null-file-${pkgver}-linux-${CARCH}"
  install -Dm755 null-file "$pkgdir/usr/bin/null-file"
  install -Dm644 dev.nullgrid.file.desktop "$pkgdir/usr/share/applications/dev.nullgrid.file.desktop"
  for s in 32 128 256 512; do
    install -Dm644 "icons/${s}x${s}.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/dev.nullgrid.file.png"
  done
  install -Dm644 icons/scalable.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.nullgrid.file.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
